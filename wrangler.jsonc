{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codex-ascend-contest",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "GENERATED_ART",
      "bucket_name": "codex-ascend-generated-art"
    }
  ],
  "workflows": [
    {
      "binding": "GENERATION_WORKFLOW",
      "name": "codex-ascend-generation",
      "class_name": "AscendGenerationWorkflow"
    }
  ],
  "vars": {
    "GENERATION_ENABLED": "true",
    "OPENAI_IMAGE_MODEL": "gpt-image-2-2026-04-21",
    "OPENAI_IMAGE_SIZE": "3840x2160",
    "OPENAI_IMAGE_QUALITY": "high"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY", "ASCEND_GENERATION_ADMIN_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
